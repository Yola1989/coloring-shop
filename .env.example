# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password to log into /admin
ADMIN_PASSWORD="choose-a-strong-password"

# S3-compatible object storage for book images.
# Works with Cloudflare R2, MinIO, AWS S3, or any S3-compatible provider —
# so you can move from Vercel to a VPS later without changing the code.
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="coloring-shop"
# Public base URL your uploaded files are served from
# (R2 public bucket dev URL, or a custom domain/CDN in front of the bucket)
S3_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Email notification sent to you every time a new order is placed.
# Works with any SMTP provider (Gmail, Resend, SendGrid, Mailtrap, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ORDER_NOTIFY_EMAIL="you@example.com"
