generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  price       Int
  cover       String
  description String
  pages       Int
  age         String
  position    Int      @default(0)
  preview     String[]
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  fullName    String
  phone       String
  city        String
  address     String
  notes       String?
  totalAmount Int
  status      OrderStatus @default(NEW)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  book       Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  bookId     Int?
  offerId    Int?
  title      String
  price      Int
  quantity   Int
}

model Promotion {
  id          Int      @id @default(autoincrement())
  enabled     Boolean  @default(false)
  title       String   @default("")
  description String   @default("")
  book1Id     Int?
  book1Price  Int?
  book2Id     Int?
  book2Price  Int?
  updatedAt   DateTime @updatedAt
}

model SpecialOffer {
  id          Int      @id @default(autoincrement())
  enabled     Boolean  @default(false)
  title       String
  description String
  imageUrl    String
  price       Int
  oldPrice    Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id             Int    @id @default(autoincrement())
  whatsappNumber String @default("")
}
