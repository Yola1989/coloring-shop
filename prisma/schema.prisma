generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  price       Int
  cover       String
  description String
  pages       Int
  age         String
  preview     String[]
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  fullName    String
  phone       String
  city        String
  address     String
  notes       String?
  totalAmount Int
  status      OrderStatus @default(NEW)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  book       Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  bookId     Int?
  offerId    Int?
  // Snapshot of book/offer data at order time, so edits/deletes to the
  // book or offer later don't change historical orders.
  title      String
  price      Int
  quantity   Int
}

// A single, simple homepage promotion banner ("Books Promotion" in the
// admin). No relation to Book on purpose — book1Id/book2Id are plain
// references so this model stays self-contained and easy to extend later.
model Promotion {
  id          Int      @id @default(autoincrement())
  enabled     Boolean  @default(false)
  title       String   @default("")
  description String   @default("")
  book1Id     Int?
  book1Price  Int?
  book2Id     Int?
  book2Price  Int?
  updatedAt   DateTime @updatedAt
}

// Independent from Promotion/books — for bundles and future non-book
// products. Modeled as a normal list (not fixed slots) so adding a 3rd,
// 4th, etc. offer later needs no schema or code changes, just a new row.
model SpecialOffer {
  id          Int      @id @default(autoincrement())
  enabled     Boolean  @default(false)
  title       String
  description String
  imageUrl    String
  price       Int
  oldPrice    Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Single-row site settings, same pattern as Promotion. New settings
// (beyond whatsappNumber) can be added later as new optional columns.
model Settings {
  id             Int    @id @default(autoincrement())
  whatsappNumber String @default("")
}
